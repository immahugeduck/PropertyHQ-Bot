# --- Twilio (active phone integration) ---
# Required: verifies X-Twilio-Signature on inbound webhooks. Find it in the
# Twilio Console dashboard (Account Info -> Auth Token).
TWILIO_AUTH_TOKEN=

# Optional but recommended: your Twilio Account SID (starts with "AC...").
TWILIO_ACCOUNT_SID=

# Optional: the Twilio phone number in E.164, e.g. +17657700925.
TWILIO_NUMBER=

# Optional: set only if signature validation fails because the reconstructed
# request URL does not match your configured webhook host (custom domain,
# redirects). Use the exact base URL Twilio calls, e.g.
# https://your-app.vercel.app
TWILIO_WEBHOOK_BASE_URL=

# --- AgentPhone (legacy/alternate provider) ---
# Required only if you also use the AgentPhone webhook.
AGENTPHONE_WEBHOOK_SECRET=

# Reserved for Phase 2 AgentPhone API operations/outbound messaging
AGENTPHONE_API_KEY=

# Reserved for AI-assisted classification after deterministic safety checks
OPENAI_API_KEY=

# Reserved for persistent tenant/property/conversation storage
DATABASE_URL=

# Optional: comma-separated numbers that receive future escalation notifications
MAINTENANCE_ESCALATION_NUMBERS=
