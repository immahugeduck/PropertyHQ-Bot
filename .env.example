# --- Twilio (active phone integration) ---
# Required: verifies X-Twilio-Signature on inbound webhooks. Find it in the
# Twilio Console dashboard (Account Info -> Auth Token).
TWILIO_AUTH_TOKEN=

# Required for outbound alert texts to maintenance/manager phones: your Twilio
# Account SID (starts with "AC...").
TWILIO_ACCOUNT_SID=

# Optional: the Twilio phone number in E.164, e.g. +17657700925.
TWILIO_NUMBER=

# Optional: set only if signature validation fails because the reconstructed
# request URL does not match your configured webhook host (custom domain,
# redirects). Use the exact base URL Twilio calls, e.g.
# https://your-app.vercel.app
TWILIO_WEBHOOK_BASE_URL=

# --- Inkbox (AI communications agent: email + iMessage) ---
# Inkbox is connected as an MCP integration, not through env-var secrets: the
# agent runs as an Inkbox identity and authenticates via the MCP key you set up
# under your tenant. These values are informational/for the runner + docs only.
#
# Agent handle of the Inkbox identity that answers tenants.
INKBOX_AGENT_HANDLE=tenant-coms-agent
# The identity's active email address (from inkbox_channel_status_get).
INKBOX_AGENT_EMAIL=tenant-coms-agent@inkboxmail.com

# iMessage connect flow (from inkbox_imessage_onboarding_get). The triage number
# is Inkbox's SHARED router for all agents; tenants text the connect command to
# it to link to this agent.
INKBOX_TRIAGE_NUMBER=+16504849720
INKBOX_IMESSAGE_CONNECT=connect @tenant-coms-agent
# The tenant's DIRECT iMessage line for this agent. Confirmed via Inkbox's own
# connect flow ("You're now connected to agent @tenant-coms-agent. Text them at
# +17176607624"). Note: inkbox_channel_status_get still reports
# dedicated_number: null — that API field just doesn't surface it; the line works.
INKBOX_DIRECT_NUMBER=+17176607624

# iMessage webhook receiver (POST /api/inkbox/imessage).
# Required to run the endpoint. Verifies X-Inkbox-Signature on inbound webhooks.
# NOTE: the exact signing scheme is PROVISIONAL until confirmed against one real
# Inkbox delivery. See src/inkbox.js: verifyInkboxSignature.
INKBOX_WEBHOOK_SECRET=
# Testing escape hatch ONLY: set to "true" to accept unsigned webhooks when no
# secret is set. Never enable in production.
INKBOX_WEBHOOK_ALLOW_UNVERIFIED=

# --- AgentPhone (legacy/alternate provider) ---
# Required only if you also use the AgentPhone webhook.
AGENTPHONE_WEBHOOK_SECRET=

# Reserved for Phase 2 AgentPhone API operations/outbound messaging
AGENTPHONE_API_KEY=

# Reserved for AI-assisted classification after deterministic safety checks
OPENAI_API_KEY=

# --- Property HQ (Supabase) ---
# When both are set, texts/calls are filed as maintenance requests in Property
# HQ, every message is logged to sms_messages, and new-request/emergency alerts
# are texted to the phones in the triage_settings row for the Twilio number.
# Use the SAME Supabase project as Property HQ. The service-role key bypasses
# row-level security: server-side only, never in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: comma-separated numbers that receive future escalation notifications
MAINTENANCE_ESCALATION_NUMBERS=
